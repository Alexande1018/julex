# Supabase — copia a .env.local y rellena con los datos del proyecto
# (Project Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Solo para migraciones desde la CLI. NO se expone al navegador.
# SUPABASE_DB_PASSWORD=

# --- Recepción por WhatsApp (secretos de las Edge Functions) ---
# Se cargan con `supabase secrets set`, no van al navegador.
# WA_APP_SECRET=          # App Secret de Meta: valida la firma del webhook
# WA_VERIFY_TOKEN=        # frase larga y aleatoria; la misma que se pega en Meta
# META_APP_ID=
# META_APP_SECRET=
# META_CONFIG_ID=         # configuración de Embedded Signup
# WA_REDIRECT_URI=https://panel.julex.es/panel/recepcion
# CRON_SECRET=            # el mismo que se guarda en config_secreta.wa_cron_secreto
