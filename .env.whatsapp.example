# Secretos del canal de WhatsApp.
#
# Copia este fichero a `.env.whatsapp` (sin `.example`) y rellena los valores.
# Ese fichero está en .gitignore: no se sube nunca.
#
# Se cargan en Supabase con:
#   npx supabase secrets set --env-file .env.whatsapp
#
# o, todo de una vez, con:
#   ./scripts/desplegar-wa.sh

# --- Modelo del agente (ya existía) ---
ASISTENTE_LLM_URL=https://api.deepseek.com/v1
ASISTENTE_LLM_KEY=
ASISTENTE_LLM_MODEL=deepseek-flash

# --- App de Meta (docs/whatsapp/meta-pasos.md, pasos 1 y 5) ---
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
WA_REDIRECT_URI=https://panel.julex.es/panel/recepcion

# --- Webhook ---
# Una frase larga y aleatoria. La misma que se pega en Meta → Webhook.
WA_VERIFY_TOKEN=
# El mismo valor que META_APP_SECRET. Con él se valida la firma de cada mensaje.
WA_APP_SECRET=

# --- Cron ---
# Otra frase larga y aleatoria. El mismo valor que se guarda en
# config_secreta.wa_cron_secreto.
CRON_SECRET=
